---
// Presents the briefing page (src/content/docs/briefing.mdx) as slides: the content is split at each horizontal rule,
// so the page and the slides can never differ. Keys: arrows, Page Up/Down and Space move; Home/End jump; N shows the
// notes; F toggles full screen; P opens a presenter window that follows this one and shows the notes and a timer.
import { Content } from '../../content/docs/briefing.mdx';
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Specification-Driven Design for Scalable AI Tooling · slides</title>
    <meta name="description" content="Discover how specification-driven design can turn AI-assisted coding into a robust and scalable CI/CD ecosystem for LabVIEW benchmarking." />
  </head>
  <body>
    <div id="deck-src"><Content /></div>
    <div id="deck-stage"><div id="deck"></div></div>
    <aside id="deck-notes" hidden></aside>
    <div id="deck-bar">
      <a href={`${base}/briefing/`}>Read as a page</a>
      <button id="deck-prev" type="button" aria-label="Previous slide">‹</button>
      <span id="deck-count"></span>
      <button id="deck-next" type="button" aria-label="Next slide">›</button>
      <span id="deck-timer" hidden></span>
      <span class="deck-help">← → move · N notes · F full screen · P presenter</span>
    </div>
    <div id="deck-progress"></div>
  </body>
</html>

<style is:global>
  html, body { margin: 0; height: 100%; background: #e2e8f0; color: #0f172a; font-family: system-ui, -apple-system, 'Segoe UI', Roboto, sans-serif; }
  #deck-src { display: none; }
  #deck-stage { position: fixed; inset: 0 0 40px 0; display: flex; align-items: center; justify-content: center; overflow: hidden; }
  #deck { position: relative; flex: none; width: 1280px; height: 720px; background: #fff; box-shadow: 0 10px 40px rgba(15, 23, 42, 0.25); transform-origin: center center; }
  .slide { position: absolute; inset: 0; box-sizing: border-box; padding: 40px 64px 56px; overflow: hidden; display: none; font-size: 28px; line-height: 1.35; }
  .slide.on { display: flex; flex-direction: column; gap: 0; }
  .slide h2 { font-size: 42px; line-height: 1.15; margin: 0; padding-left: 18px; border-left: 8px solid #2563eb; }
  .slide-body { flex: 1; min-height: 0; display: flex; flex-direction: column; justify-content: center; gap: 20px; }
  .slide ul, .slide ol { margin: 2px 0; padding-left: 1.2em; }
  .slide li { margin: 3px 0; }
  .slide p { margin: 3px 0; }
  .slide a { color: #1d4ed8; }
  .slide img { max-width: 100%; }
  .slide .b-pageonly { display: none; }
  .slide table { border-collapse: collapse; font-size: 22px; }
  .slide th, .slide td { border-bottom: 1px solid #cbd5e1; padding: 6px 12px; text-align: left; }
  .slide code { font-size: 0.85em; background: #f1f5f9; padding: 0 0.25em; border-radius: 4px; }
  .slide .b-cover { flex: 1; display: flex; flex-direction: column; justify-content: center; margin: -40px -64px -56px; padding: 48px 72px; border-radius: 0; }
  .slide .b-title { font-size: 56px; }
  .slide .b-sub { font-size: 26px; max-width: 1000px; }
  .slide .b-meta { font-size: 20px; }
  .slide .b-journey { position: absolute; right: 28px; bottom: 14px; margin: 0; }
  .slide .b-journey span { font-size: 14px; }
  .slide .b-flow, .slide .b-chain, .slide .b-timeline, .slide .b-tiles, .slide .b-hub { font-size: 25px; }
  .slide .b-tiles > div { padding: 14px 18px; }
  .slide .b-tiles strong { font-size: 1.05em; margin-bottom: 6px; }
  .slide .b-hub > div { font-size: 21px; }
  .slide .b-banner { font-size: 26px; }
  .slide .b-next { font-size: 24px; }
  .slide .b-foot { font-size: 20px; }
  .slide .b-graph { display: flex; justify-content: center; }
  .slide .b-graph img { max-height: 400px; width: auto; }
  .slide .sl-anchor-link { display: none; }
  .slide .b-status { font-size: 20px; text-align: center; }
  .slide .b-legend { justify-content: center; font-size: 20px; }
  .slide .b-cols img { max-height: 420px; border-radius: 8px; }
  .slide .b-cols { align-items: center; }
  .slide .b-steps { font-size: 25px; }
  #deck-bar { position: fixed; left: 0; right: 0; bottom: 0; height: 40px; box-sizing: border-box; display: flex; gap: 16px; align-items: center; padding: 0 16px; font-size: 14px; background: #0f172a; color: #cbd5e1; }
  #deck-bar a { color: #93c5fd; }
  #deck-bar button { background: none; border: 1px solid #475569; color: #e2e8f0; border-radius: 6px; font-size: 16px; line-height: 1; padding: 2px 10px; cursor: pointer; }
  #deck-bar .deck-help { margin-left: auto; opacity: 0.7; }
  #deck-progress { position: fixed; left: 0; bottom: 40px; height: 4px; width: 0; background: #2563eb; transition: width 0.2s; }
  #deck-notes { position: fixed; right: 16px; bottom: 56px; width: min(560px, 45vw); max-height: 45vh; overflow: auto; box-sizing: border-box; padding: 16px 20px; border-radius: 10px; background: #0f172a; color: #f8fafc; font-size: 18px; line-height: 1.5; box-shadow: 0 10px 30px rgba(0, 0, 0, 0.35); }
  #deck-notes a { color: #93c5fd; }
  #deck-notes .b-notes-label { display: none; }
  #deck-notes .deck-next { color: #fbbf24; font-weight: 700; }
  body.presenter #deck-stage { right: 42vw; }
  body.presenter #deck-notes { top: 16px; bottom: 56px; width: calc(42vw - 32px); max-height: none; font-size: 22px; }
  body.presenter #deck-timer { color: #fff; font-weight: 700; font-variant-numeric: tabular-nums; }
</style>

<script>
  const src = document.getElementById('deck-src');
  const deck = document.getElementById('deck');
  const stage = document.getElementById('deck-stage');
  const notesEl = document.getElementById('deck-notes');
  const countEl = document.getElementById('deck-count');
  const timerEl = document.getElementById('deck-timer');
  const progressEl = document.getElementById('deck-progress');

  // Split the rendered page at each horizontal rule.
  const slides = [];
  let section = document.createElement('section');
  const close = () => {
    if (section.textContent.trim() || section.querySelector('img')) { section.className = 'slide'; slides.push(section); }
    section = document.createElement('section');
  };
  for (const node of Array.from(src.childNodes)) {
    if (node.nodeName === 'HR') close(); else section.appendChild(node);
  }
  close();
  const notes = slides.map((s) => {
    const n = s.querySelector('[data-notes]');
    if (!n) return '';
    n.remove();
    return n.innerHTML;
  });
  const titles = slides.map((s, k) => s.querySelector('h2')?.textContent ?? (k === 0 ? 'Title' : `Slide ${k + 1}`));
  // Title at the top, everything else centred in the space below it; the journey tracker sits in a corner.
  for (const s of slides) {
    const head = Array.from(s.children).find((c) => c.matches('h2') || c.querySelector('h2'));
    if (!head) continue;
    const body = document.createElement('div');
    body.className = 'slide-body';
    for (const node of Array.from(s.childNodes)) {
      if (node === head || (node.nodeType === 1 && node.classList.contains('b-journey'))) continue;
      body.appendChild(node);
    }
    s.appendChild(body);
  }
  slides.forEach((s) => deck.appendChild(s));
  src.remove();

  const presenter = new URLSearchParams(location.search).has('presenter');
  if (presenter) { document.body.classList.add('presenter'); notesEl.hidden = false; timerEl.hidden = false; }
  const channel = 'BroadcastChannel' in window ? new BroadcastChannel('ecosystem-briefing') : null;

  let i = 0;
  const show = (n, quiet) => {
    i = Math.max(0, Math.min(slides.length - 1, n));
    slides.forEach((s, k) => s.classList.toggle('on', k === i));
    countEl.textContent = `${i + 1} / ${slides.length}`;
    progressEl.style.width = `${((i + 1) / slides.length) * 100}%`;
    notesEl.innerHTML = notes[i] || '<p>No notes for this slide.</p>';
    if (presenter) {
      const next = document.createElement('p');
      next.className = 'deck-next';
      next.textContent = `Next: ${titles[i + 1] ?? 'end of the briefing'}`;
      notesEl.prepend(next);
    }
    history.replaceState(null, '', `#${i + 1}`);
    if (!quiet && channel) channel.postMessage(i);
  };
  channel?.addEventListener('message', (e) => show(e.data, true));

  const fit = () => {
    const r = stage.getBoundingClientRect();
    deck.style.transform = `scale(${Math.min(r.width / 1280, r.height / 720) * 0.97})`;
  };
  addEventListener('resize', fit);

  addEventListener('keydown', (e) => {
    if (e.altKey || e.ctrlKey || e.metaKey) return;
    const k = e.key;
    if (['ArrowRight', 'ArrowDown', 'PageDown', ' '].includes(k)) { e.preventDefault(); show(i + 1); }
    else if (['ArrowLeft', 'ArrowUp', 'PageUp'].includes(k)) { e.preventDefault(); show(i - 1); }
    else if (k === 'Home') show(0);
    else if (k === 'End') show(slides.length - 1);
    else if (k === 'n' || k === 'N') notesEl.hidden = !notesEl.hidden;
    else if (k === 'f' || k === 'F') { if (document.fullscreenElement) document.exitFullscreen(); else document.documentElement.requestFullscreen(); }
    else if (k === 'p' || k === 'P') window.open(`${location.pathname}?presenter#${i + 1}`, 'briefing-presenter', 'width=1280,height=800');
  });
  document.getElementById('deck-prev').addEventListener('click', () => show(i - 1));
  document.getElementById('deck-next').addEventListener('click', () => show(i + 1));

  const t0 = Date.now();
  if (presenter) setInterval(() => {
    const s = Math.floor((Date.now() - t0) / 1000);
    timerEl.textContent = `${Math.floor(s / 60)}:${String(s % 60).padStart(2, '0')}`;
  }, 1000);

  show((parseInt(location.hash.slice(1), 10) || 1) - 1, true);
  fit();
</script>
