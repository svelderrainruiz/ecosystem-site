---
import members from '../data/members.json';
import status from '../data/status.json';
import testPages from '../data/test-pages.json';

interface Props { id: string }
const { id } = Astro.props;
const member = members.find((m) => m.id === id);
if (!member) throw new Error(`Unknown member: ${id}`);
const s = status.members.find((m) => m.id === id);
const tp = testPages[id];
const tpTotal = tp ? tp.canonical + tp.fileLevel + tp.stub : 0;
const tpText = tp && (tp.fileLevel > 0 ? `${tp.canonical} per-case plus ${tp.fileLevel} file-level canonical, ${tp.stub} stub` : `${tp.canonical} canonical, ${tp.stub} stub`);
const isPublic = member.visibility === 'public';
const scopes = Object.entries(s?.scopes ?? {}).filter(([, count]) => count > 0);
const scopeLabel = { software: 'Software requirements', system: 'System requirements', test: 'Tests' };
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
// lastExport is UTC to the second (YYYY-MM-DDTHH:MM:SSZ); the card shows "YYYY-MM-DD HH:MM:SS UTC".
const exportedAt = s?.exported ? s.lastExport : null;
const exportedShown = exportedAt && `${exportedAt.slice(0, 10)} ${exportedAt.slice(11, 19)} UTC`;
---
<article class="card" data-member-id={id}>
  <header>
    <h3>{member.name}</h3>
    <span class={`badge ${isPublic ? 'public' : 'private'}`}>{member.visibility}</span>
  </header>
  <p class="role">{member.role}</p>
  <ul class="facts">
    {s?.pin && (<li><span>RSR release pinned</span>{' '}<span><code>{s.pin.tag}</code></span></li>)}
    <li class="export"><span>Registry export</span>{' '}<span>{exportedAt ? <>last on <time datetime={exportedAt}>{exportedShown}</time></> : 'none yet'}</span></li>
    {isPublic && s?.revision && (<li><span>Exported revision</span>{' '}<span><code>{s.revision}</code></span></li>)}
    {scopes.map(([scope, count]) => (<li><span>{scopeLabel[scope] ?? scope}</span>{' '}<span>{count}</span></li>))}
    {tpTotal > 0 && (<li><span>Test pages</span>{' '}<span>{tpText}</span></li>)}
    {s?.edges ? (<li><span>Trace links</span>{' '}<span>{s.edges}</span></li>) : null}
  </ul>
  {!isPublic && member.rules && (
    <p class="rules">Rules: {member.rules.map((r) => <code>{r}</code>)}</p>
  )}
  {isPublic && member.wiki && <p><a href={member.wiki}>Wiki</a> · <a href={member.repo}>Repository</a></p>}
  {!isPublic && <p class="note">Private: counts only.{member.summary && (<> <a href={`${base}${member.summary}`}>Public summary</a></>)}</p>}
</article>
<style>
  .card { margin: 0; border: 1px solid var(--sl-color-gray-5); border-radius: 0.5rem; padding: 1rem; background: var(--sl-color-bg-nav); }
  header { display: flex; justify-content: space-between; align-items: baseline; gap: 0.5rem; }
  h3 { margin: 0; font-size: var(--sl-text-lg); }
  .badge { font-size: var(--sl-text-xs); padding: 0.1rem 0.5rem; border-radius: 1rem; border: 1px solid var(--sl-color-gray-4); }
  .badge.public { color: var(--sl-color-green-high); }
  .badge.private { color: var(--sl-color-orange-high); }
  .role { margin: 0.4rem 0; color: var(--sl-color-gray-2); }
  .facts { list-style: none; padding: 0; margin: 0.5rem 0; font-size: var(--sl-text-sm); }
  .facts li { display: flex; justify-content: space-between; gap: 1rem; margin: 0; padding: 0.15rem 0; border-bottom: 1px solid var(--sl-color-gray-6); }
  .facts li span:first-child { color: var(--sl-color-gray-3); }
  /* The export time is the one long value: keep it whole, and drop it to its own right-aligned line when the card is narrow. */
  .facts li.export { flex-wrap: wrap; row-gap: 0; }
  .facts li.export span:last-child { margin-left: auto; white-space: nowrap; }
  .rules code { margin-right: 0.3rem; }
  .note { color: var(--sl-color-gray-3); font-size: var(--sl-text-sm); }
  p { margin: 0.4rem 0; }
</style>
