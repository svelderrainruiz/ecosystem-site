---
import members from '../data/members.json';
import MemberCard from './MemberCard.astro';
---
<div class="grid">
  {members.map((m) => <MemberCard id={m.id} />)}
</div>
<style>
  .grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(18rem, 1fr)); gap: 1rem; margin: 1.5rem 0; }
</style>
